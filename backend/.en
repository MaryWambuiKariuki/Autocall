# Copy to .env and fill in. NEVER commit .env or serviceAccountKey.json
FIREBASE_CREDENTIALS=serviceAccountKey.json
PORT=5000

# --- M-Pesa Daraja (https://developer.safaricom.co.ke) ---
MPESA_ENV=sandbox
MPESA_MOCK=false            # true = fake the STK push so you can demo without Daraja/ngrok
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=              # copy the sandbox passkey from the Daraja portal (Lipa na M-Pesa Online > Simulate)
PUBLIC_BASE_URL=https://YOUR-NGROK-URL.ngrok-free.app
MPESA_CALLBACK_SECRET=put-a-long-random-string-here

# --- models (leave as is) ---
RECOMMENDER_MODEL=models/recommendation_model.pkl
RECOMMENDER_SCALER=models/recommendation_scaler.pkl
SENTIMENT_MODEL_DIR=models/roberta_sentiment
